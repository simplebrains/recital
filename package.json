{
  "name": "@simplebrains/recital",
  "version": "0.3.0",
  "description": "Run Markdown files that describe CLI sessions — as documentation, and as executable/verifiable tests.",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cli",
    "markdown",
    "test",
    "transcript",
    "documentation",
    "vitest",
    "repl"
  ],
  "license": "MIT",
  "author": "Brendan Baldwin",
  "type": "module",
  "bin": {
    "recital": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js",
      "require": "./dist/vitest.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "vitest": ">=1"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
